{
  "name": "pi-actsis-litellm",
  "version": "0.1.0",
  "description": "Pi extension for a LiteLLM gateway provider with OAuth PKCE login and dynamic model catalog.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "keywords": [
    "pi-package",
    "pi",
    "litellm",
    "oauth",
    "provider"
  ],
  "homepage": "https://github.com/ACTSIS/pi-actsis-litellm#readme",
  "bugs": {
    "url": "https://github.com/ACTSIS/pi-actsis-litellm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACTSIS/pi-actsis-litellm.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
